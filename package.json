{
  "name": "slidev-theme-itenium",
  "version": "0.1.0",
  "description": "Slidev theme for itenium technical presentations",
  "keywords": [
    "slidev-theme"
  ],
  "homepage": "https://github.com/itenium-be/presentations",
  "repository": {
    "type": "git",
    "url": "https://github.com/itenium-be/presentations.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "slidev talks/showcase/slides.md",
    "build": "slidev build talks/showcase/slides.md",
    "scaffold": "bun run scripts/scaffold.ts",
    "build-all": "bun run scripts/build-all.ts"
  },
  "slidev": {
    "defaults": {
      "favicon": "./theme/assets/favicon.png",
      "titleTemplate": "%s @ itenium",
      "colorSchema": "dark",
      "aspectRatio": "16/10"
    }
  },
  "peerDependencies": {
    "@slidev/types": ">=0.1.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@slidev/cli": "^51.0.0",
    "@slidev/types": "^51.0.0"
  }
}
