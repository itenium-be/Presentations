---
interface Props {
  talk: {
    title: string
    description: string
    repo: string
    date: string
    lastUpdate?: string
    category: string
    coverExt: string
    slideCount: number
    frontmatter: Record<string, any>
  }
}

const { talk } = Astro.props
const slug = talk.repo.split('/').pop()
const slidesUrl = `/Presentations/${slug}/`
const repoUrl = `https://github.com/${talk.repo}`
const coverUrl = `/Presentations/${slug}/cover-art.${talk.coverExt}`
const pptxUrl = `https://github.com/${talk.repo}/raw/master/${slug}.pptx`

const displayDate = talk.lastUpdate || talk.date
const dateStr = new Date(String(displayDate)).toLocaleDateString('en-BE', {
  year: 'numeric',
  month: 'short',
})

const subTitle = talk.frontmatter?.subTitle
const sessionTime = talk.frontmatter?.['session-time']
const track = talk.frontmatter?.track
const talkType = talk.frontmatter?.type
---

<a href={slidesUrl} class="card-link">
<article class="card">
    <div class="card-cover">
      <img src={coverUrl} alt="" loading="lazy" onerror="this.style.display='none'" />
      <button class="btn-download" onclick={`event.preventDefault();event.stopPropagation();document.getElementById('modal-${slug}').showModal()`} aria-label="Download PPTX" title="Download PPTX">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      </button>
      <a href={slidesUrl} class="cover-overlay">View Slides</a>
    </div>
    <div class="card-content">
      <div class="card-top">
        <div class="card-header">
          <div>
            <h2 class="card-title">{talk.title}</h2>
            {subTitle && <p class="card-subtitle">{subTitle}</p>}
          </div>
          <span class="card-badge">{talk.category}</span>
        </div>
      </div>
      <div class="card-meta">
        {sessionTime && <span class="meta-item">{sessionTime}</span>}
        {talk.slideCount > 0 && <span class="meta-item">{talk.slideCount} slides</span>}
        {track && <span class="meta-item">{track}</span>}
        {talkType && <span class="meta-item">{talkType}</span>}
      </div>
      <p class="card-desc">{talk.description}</p>
      <div class="card-footer">
        <span class="card-date">{dateStr}</span>
        <div class="card-actions">
          <a href={repoUrl} class="btn-icon" target="_blank" onclick="event.stopPropagation()" aria-label="GitHub repository" title="GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </article>
</a>

<dialog id={`modal-${slug}`} class="pptx-modal">
  <div class="modal-content">
    <h3>Download PowerPoint Copy</h3>
    <p>This is a static export of the slides as images. Animations, transitions, and interactive elements are not included. For the full experience, <a href={slidesUrl}>view the slides online</a>.</p>
    <div class="modal-actions">
      <button class="modal-cancel" onclick={`document.getElementById('modal-${slug}').close()`}>Cancel</button>
      <a href={pptxUrl} class="modal-download" download>Download Copy</a>
    </div>
  </div>
</dialog>

<style>
.card-link {
  text-decoration: none;
  color: inherit;
  display: block;
  cursor: default;
}

.pptx-modal {
  border: none;
  border-radius: 12px;
  padding: 0;
  max-width: 420px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}
.pptx-modal::backdrop {
  background: rgba(0, 0, 0, 0.4);
}
.modal-content {
  padding: 1.5rem;
  font-family: 'Inter', sans-serif;
}
.modal-content h3 {
  font-family: 'Rubik', sans-serif;
  font-weight: 500;
  margin: 0 0 0.75rem;
  font-size: 1.1rem;
  color: #343434;
}
.modal-content p {
  font-size: 0.88rem;
  color: #555;
  line-height: 1.5;
  margin: 0 0 1.25rem;
}
.modal-content p a {
  color: #e84700;
  text-decoration: none;
}
.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
}
.modal-cancel {
  padding: 0.45rem 1rem;
  border-radius: 6px;
  border: 1px solid #ccc;
  background: white;
  font-family: 'Inter', sans-serif;
  font-size: 0.85rem;
  cursor: pointer;
  color: #555;
}
.modal-cancel:hover { background: #f5f5f5; }
.modal-download {
  padding: 0.45rem 1rem;
  border-radius: 6px;
  background: #e84700;
  color: white;
  font-family: 'Inter', sans-serif;
  font-size: 0.85rem;
  font-weight: 500;
  text-decoration: none;
  cursor: pointer;
}
.modal-download:hover { background: #d03f00; }

.card {
  display: flex;
  flex-direction: row;
  background: white;
  border: 1px solid #e0e0e0;
  border-radius: 10px;
  overflow: hidden;
  transition: box-shadow 0.2s, transform 0.2s;
}
.card:hover {
  box-shadow: 0 6px 24px rgba(232, 71, 0, 0.12);
  transform: translateY(-2px);
}

.card-cover {
  width: 240px;
  min-height: 200px;
  flex-shrink: 0;
  background: #2D2A28;
  position: relative;
}
.card-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.card-content {
  flex: 1;
  padding: 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.card-top {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin-bottom: 0.4rem;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
}
.card-title {
  font-family: 'Rubik', sans-serif;
  font-weight: 500;
  font-size: 1.2rem;
  margin: 0;
  color: #343434;
  line-height: 1.3;
}
.card-subtitle {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.82rem;
  color: #7e7e7e;
  margin: 0.2rem 0 0;
}

.card-badge {
  background: #E78200;
  color: white;
  font-family: 'Inter', sans-serif;
  font-size: 0.7rem;
  font-weight: 600;
  padding: 0.2rem 0.65rem;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  white-space: nowrap;
  flex-shrink: 0;
  height: fit-content;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.meta-item {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.73rem;
  color: #7e7e7e;
  background: #f5f5f5;
  padding: 0.2rem 0.55rem;
  border-radius: 3px;
  border: 1px solid #eee;
}

.card-desc {
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  color: #555;
  line-height: 1.55;
  margin: 0.75rem 0;
  flex: 1;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid #f0f0f0;
  padding-top: 0.75rem;
  margin-top: auto;
}
.cover-overlay {
  position: absolute;
  bottom: 0.5rem;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(232, 71, 0, 0.9);
  color: white;
  font-family: 'Inter', sans-serif;
  font-size: 0.75rem;
  font-weight: 500;
  padding: 0.35rem 0.75rem;
  border-radius: 20px;
  cursor: pointer;
  text-decoration: none;
  z-index: 1;
  transition: background 0.15s;
}
.cover-overlay:hover {
  background: #e84700;
}

.btn-download {
  position: absolute;
  top: 0.5rem;
  left: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: none;
  border-radius: 50%;
  background: rgba(0,0,0,0.55);
  color: white;
  cursor: pointer;
  transition: background 0.15s;
  z-index: 1;
}
.btn-download:hover {
  background: rgba(0,0,0,0.8);
}
.card-date {
  font-family: 'Inter', sans-serif;
  color: #7e7e7e;
  font-size: 0.8rem;
}
.card-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #343434;
  color: white;
  transition: opacity 0.15s;
}
.btn-icon:hover { opacity: 0.8; }
.btn-icon svg {
  width: 18px;
  height: 18px;
}

@media (max-width: 768px) {
  .card {
    flex-direction: column;
    position: relative;
  }
  .card-cover {
    width: 100%;
    min-height: 0;
    max-height: none;
  }
  .card-cover img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .card-content {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
  }
  .card-content > * {
    pointer-events: auto;
  }
  .card-top {
    background: rgba(0,0,0,0.65);
    padding: 0.75rem 1rem;
    margin-bottom: 0;
  }
  .card-title {
    font-size: 1.05rem;
    color: white;
  }
  .card-subtitle {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.8);
  }
  .card-badge {
    background: rgba(231, 130, 0, 0.9);
  }
  .card-meta {
    display: none;
  }
  .card-desc { display: none; }
  .card-footer {
    background: none;
    padding: 0.75rem 1rem;
    border-top: none;
    margin-top: auto;
    display: flex;
    gap: 0.5rem;
  }
  .card-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.73rem;
    color: rgba(255,255,255,0.85);
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.15);
    padding: 0.2rem 0.55rem;
    border-radius: 3px;
  }
  .btn-download { display: none; }
  .cover-overlay { display: none; }
  .card-link { cursor: pointer; }
  .btn-icon {
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.15);
    width: 28px;
    height: 28px;
  }
}
</style>
