---
import { readFileSync, existsSync } from 'fs'
import { resolve } from 'path'
import yaml from 'js-yaml'
import matter from 'gray-matter'
import TalkCard from '../components/TalkCard.astro'

interface Talk {
  title: string
  published: boolean
  description: string
  repo: string
  date: string
  lastUpdate?: string
  category: string
}

function countSlides(slidesPath: string): number {
  try {
    const raw = readFileSync(slidesPath, 'utf-8')
    const content = matter(raw).content.trim()
    const parts = content.split(/^---$/m).map(s => s.trim()).filter(Boolean)
    let count = 1
    let i = 1
    while (i < parts.length) {
      const p = parts[i]
      const isFm = p.split('\n').every(l => /^[a-zA-Z][\w-]*\s*:/.test(l.trim()) || l.trim() === '')
      if (isFm && i + 1 < parts.length) {
        count++
        i += 2
      } else {
        count++
        i++
      }
    }
    return count
  } catch { return 0 }
}

const talksPath = resolve(process.cwd(), '../talks.yaml')
const allTalks = yaml.load(readFileSync(talksPath, 'utf-8')) as Talk[]

const sorted = allTalks
  .filter(t => t.published)
  .sort((a, b) => {
    const aDate = String(a.lastUpdate || a.date)
    const bDate = String(b.lastUpdate || b.date)
    return bDate.localeCompare(aDate)
  })

const enriched = sorted.map(talk => {
  const slug = talk.repo.split('/').pop()!
  const slidesPath = resolve(process.cwd(), `../.talks-cache/${slug}/presentation/slides.md`)
  let fm: Record<string, string> = {}
  let coverExt = 'png'
  try {
    fm = matter(readFileSync(slidesPath, 'utf-8')).data as Record<string, string>
  } catch {}
  for (const ext of ['png', 'jpg', 'jpeg', 'webp']) {
    const imgPath = resolve(process.cwd(), `../.talks-cache/${slug}/presentation/images/cover-art.${ext}`)
    if (existsSync(imgPath)) { coverExt = ext; break }
  }
  const slideCount = countSlides(slidesPath)
  return { ...talk, frontmatter: fm, coverExt, slideCount }
})

const allCategories = [...new Set(sorted.map(t => t.category))].sort()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>itenium — Technical Talks</title>
    <link rel="icon" href="/Presentations/favicon.png" type="image/png" />

    <!-- SEO / Open Graph -->
    <meta name="description" content="Technical presentations and knowledge sharing by itenium. Browse our collection of talks on testing, AI, architecture, and more." />
    <meta property="og:title" content="itenium — Technical Talks" />
    <meta property="og:description" content="Technical presentations and knowledge sharing by itenium." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://itenium-be.github.io/Presentations/" />
    <meta property="og:image" content="https://itenium-be.github.io/Presentations/logo-full-white.svg" />
    <meta property="og:site_name" content="itenium Presentations" />
    <meta name="twitter:card" content="summary" />

    <style>
      @font-face { font-family: 'Rubik'; font-weight: 400; src: url('/Presentations/fonts/rubik-400.woff2') format('woff2'); }
      @font-face { font-family: 'Rubik'; font-weight: 500; src: url('/Presentations/fonts/rubik-500.woff2') format('woff2'); }
      @font-face { font-family: 'Rubik'; font-weight: 700; src: url('/Presentations/fonts/rubik-700.woff2') format('woff2'); }
      @font-face { font-family: 'Inter'; font-weight: 400; src: url('/Presentations/fonts/inter-400.woff2') format('woff2'); }
      @font-face { font-family: 'Inter'; font-weight: 600; src: url('/Presentations/fonts/inter-600.woff2') format('woff2'); }
      @font-face { font-family: 'IBM Plex Mono'; font-weight: 400; src: url('/Presentations/fonts/ibm-plex-mono-400.woff2') format('woff2'); }

      *, *::before, *::after { box-sizing: border-box; }

      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: #f5f5f5;
        color: #343434;
        margin: 0;
        padding: 0;
      }

      /* Hero */
      .hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #E78200 0%, #e84700 100%);
        padding: 3rem 2rem 2.5rem;
        min-height: 220px;
        display: flex;
        align-items: flex-end;
      }
      .hero-dots {
        position: absolute;
        top: -10%;
        right: -5%;
        height: 140%;
        opacity: 0.18;
        transform: rotate(-30deg);
        pointer-events: none;
        user-select: none;
      }
      .hero-inner {
        position: relative;
        max-width: 1100px;
        margin: 0 auto;
        width: 100%;
      }
      .hero-logo {
        height: 36px;
        width: auto;
        margin-bottom: 1.25rem;
        opacity: 0.9;
      }
      .hero h1 {
        font-family: 'Rubik', sans-serif;
        font-weight: 700;
        font-size: 2.4rem;
        color: white;
        margin: 0;
        line-height: 1.15;
      }
      .hero-subtitle {
        font-family: 'Inter', sans-serif;
        color: rgba(255, 255, 255, 0.8);
        font-size: 1rem;
        margin: 0.5rem 0 0;
      }

      /* Main */
      main {
        max-width: 1100px;
        margin: 2rem auto;
        padding: 0 1.5rem;
      }

      /* Filter */
      .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.75rem;
        align-items: center;
      }
      .filter-label {
        font-size: 0.85rem;
        color: #7e7e7e;
        margin-right: 0.25rem;
      }
      .filter-btn {
        font-family: 'Inter', sans-serif;
        padding: 0.3rem 0.75rem;
        border-radius: 20px;
        border: 1px solid #ccc;
        background: white;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.15s;
      }
      .filter-btn:hover,
      .filter-btn.active {
        background: #e84700;
        color: white;
        border-color: #e84700;
      }

      /* Cards list */
      .talks-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      /* Footer */
      footer {
        max-width: 1100px;
        margin: 3rem auto 0;
        padding: 1.5rem;
        border-top: 1px solid #e0e0e0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
      }
      .footer-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .footer-logo {
        height: 20px;
        width: auto;
      }
      .footer-text {
        font-size: 0.8rem;
        color: #7e7e7e;
      }
      .footer-links {
        display: flex;
        gap: 1rem;
        font-size: 0.8rem;
      }
      .footer-links a {
        color: #e84700;
        text-decoration: none;
      }
      .footer-links a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <header class="hero">
      <img src="/Presentations/dots-orange.png" class="hero-dots" aria-hidden="true" />
      <div class="hero-inner">
        <img src="/Presentations/logo-full-white.svg" alt="itenium" class="hero-logo" />
        <h1>Technical Talks</h1>
        <p class="hero-subtitle">Presentations & knowledge sharing by itenium</p>
      </div>
    </header>

    <main>
      <div class="filter-bar">
        <span class="filter-label">Filter:</span>
        <button class="filter-btn active" data-tag="all">All ({enriched.length})</button>
        {allCategories.map(cat => (
          <button class="filter-btn" data-tag={cat}>{cat}</button>
        ))}
      </div>

      <div class="talks-list" id="talks-grid">
        {enriched.map(talk => (
          <div class="talk-item" data-tags={talk.category}>
            <TalkCard talk={talk} />
          </div>
        ))}
      </div>
    </main>

    <footer>
      <div class="footer-brand">
        <img src="/Presentations/logo-itenium.svg" alt="itenium" class="footer-logo" />
        <span class="footer-text">Part of itenium academy</span>
      </div>
      <div class="footer-links">
        <a href="https://itenium.be" target="_blank">itenium.be</a>
        <a href="https://github.com/itenium-be/Presentations" target="_blank">Theme source</a>
      </div>
    </footer>

    <script>
      const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn')
      const items = document.querySelectorAll<HTMLElement>('.talk-item')

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => b.classList.remove('active'))
          btn.classList.add('active')
          const tag = btn.dataset.tag

          items.forEach(item => {
            const tags = item.dataset.tags?.split(',') ?? []
            item.style.display = tag === 'all' || tags.includes(tag!) ? '' : 'none'
          })
        })
      })
    </script>
  </body>
</html>
